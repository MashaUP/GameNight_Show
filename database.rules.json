        },
        "next": {
          ".read": "auth != null",
          ".write": "auth != null && ((root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true) || root.child('groups').child($gid).child('uids').child(auth.uid).val() === true)",
          "at": {
            ".validate": "newData.isNumber()"
          },
          "place": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "note": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          },
          "rsvp": {
            "$k": {
              ".validate": "newData.hasChildren(['name', 'answer']) && newData.child('answer').val().matches(/^(si|forse|no)$/)"
            }
          },
          "bring": {
            "$k": {
              ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length <= 16",
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
              },
              "food": {
                ".validate": "newData.isString() && newData.val().length <= 60"
              },
              "games": {
                "$lid": {
                  ".validate": "newData.isBoolean()"
                }
              },
              "$other": {
                ".validate": "false"
              }
            }
          }
        },
        "photos": {
          ".read": "auth != null && (root.child('groups').child($gid).child('privacy').child('private').val() !== true || root.child('groups').child($gid).child('uids').child(auth.uid).val() === true || (root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true))",
          "$room": {
            "$pid": {
              ".write": "auth != null && ((root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true) || root.child('groups').child($gid).child('uids').child(auth.uid).val() === true) && (!data.exists() || data.child('uid').val() === auth.uid || root.child('rooms').child($room).child('meta').child('hostUid').val() === auth.uid)",
              ".validate": "(newData.hasChildren(['data', 'uid']) && newData.child('uid').val() === auth.uid && newData.child('data').isString() && newData.child('data').val().beginsWith('data:image/') && newData.child('data').val().length < 200000 && !newData.child('data').val().contains('\"') && !newData.child('data').val().contains('<') && (!newData.child('caption').exists() || newData.child('caption').val().length <= 80)) && ((root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true) || newData.parent().parent().parent().child('rate').child(auth.uid).child('photo').val() === now)"
            }
          }
        },
        "admins": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ((root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid) || (auth.uid === $uid && root.child('groupKeys').child($gid).exists() && root.child('groupKeyClaims').child($gid).child(auth.uid).val() === root.child('groupKeys').child($gid).val()))",
            ".validate": "newData.isBoolean()"
          }
        },
        "uids": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.isBoolean()"
          }
        },
        "rate": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "photo": {
              ".validate": "newData.val() === now && (!data.exists() || now - data.val() >= 8000)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "privacy": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || root.child('groups').child($gid).child('admins').child(auth.uid).val() === true)",
          "private": {
            ".validate": "newData.isBoolean()"
          },
          "expireDays": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 365"
          },
          "$other": {
            ".validate": "false"
          }
        }
      }
    },
    "groupKeys": {
      "$gid": {
        ".write": "auth != null && root.child('groups').child($gid).child('info').exists() && (root.child('groups').child($gid).child('info').child('ownerUid').val() === auth.uid || (!data.exists() && !root.child('groups').child($gid).child('admins').exists()))",
        ".validate": "newData.isString() && newData.val().length === 8"
      }
    },
    "groupKeyClaims": {
      "$gid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length === 8"
        }
      }
    },
    "deviceProfiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$gid": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{6}$/)"
        }
      }
    },
    "armadi": {
      "$aid": {
        ".validate": "$aid.matches(/^[A-Z0-9]{6}$/)",
        "info": {
          ".read": "auth != null",
          ".write": "auth != null && (!data.exists() || data.child('ownerUid').val() === auth.uid)",
          ".validate": "newData.hasChildren(['name', 'ownerUid']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40 && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && newData.child('ownerUid').val() === data.child('ownerUid').val()))"
        },
        "library": {
          ".read": "auth != null",
          "$item": {
            ".write": "auth != null && root.child('armadi').child($aid).child('info').exists() && (root.child('armadi').child($aid).child('info').child('ownerUid').val() === auth.uid || root.child('armadi').child($aid).child('admins').child(auth.uid).val() === true || root.child('armadi').child($aid).child('uids').child(auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['name']) && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 40",
            "image": {
              ".validate": "newData.isString() && newData.val().length < 600000"
            },
            "minPlayers": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
            },
            "maxPlayers": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20"
            },
            "duration": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 600"
            },
            "quick": {
              ".validate": "newData.isBoolean()"
            },
            "weight": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5"
            },
            "year": {
              ".validate": "newData.isNumber() && newData.val() >= 1900 && newData.val() <= 2100"
            },
            "status": {
              ".validate": "newData.isString() && newData.val().matches(/^(posseduto|prestato|non disponibile|venduto)$/)"
            },
            "mode": {
              ".validate": "newData.isString() && newData.val().matches(/^(competitivo|cooperativo|squadre|misto)$/)"
            },
            "publisher": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "language": {
              ".validate": "newData.isString() && newData.val().length <= 20"
            },
            "loanTo": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "baseId": {
              ".validate": "newData.isString() && newData.val().length <= 40"
            },
            "owner": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "tags": {
              "$t": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              }
            },
            "ean": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{8,14}$/)"
            },
            "rules": {
              ".validate": "newData.isString() && newData.val().length <= 600"
            },
            "setup": {
              ".validate": "newData.isString() && newData.val().length <= 300"
            },
            "video": {
              ".validate": "newData.isString() && newData.val().length <= 200 && newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains('<') && !newData.val().contains('>')"
            },
            "sel": {
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "admins": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && ((root.child('armadi').child($aid).child('info').child('ownerUid').val() === auth.uid) || (auth.uid === $uid && root.child('armadioKeys').child($aid).exists() && root.child('armadioKeyClaims').child($aid).child(auth.uid).val() === root.child('armadioKeys').child($aid).val()))",
            ".validate": "newData.isBoolean()"
          }
        },
        "uids": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && (root.child('armadi').child($aid).child('info').child('ownerUid').val() === auth.uid || root.child('armadi').child($aid).child('admins').child(auth.uid).val() === true)",
            ".validate": "newData.isBoolean()"
          }
        },
        "$other": {
          ".validate": "false"
        }
      }
    },
    "armadioKeys": {
      "$aid": {
        ".write": "auth != null && root.child('armadi').child($aid).child('info').child('ownerUid').val() === auth.uid",
        ".validate": "newData.isString() && newData.val().length === 8"
      }
    },
    "armadioKeyClaims": {
      "$aid": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length === 8"
        }
      }
    }
  }
}
